# DROPZONE environment template.
# Copy to .env (git-ignored) and fill in real values. No real secrets here.
#
# Consumers:
#   server/index.mjs + workers/signaling/index.mjs -> signaling protocol v1
#   docker-compose.yml + infra/coturn/entrypoint.sh -> coturn relay
#   the Vite build -> the static SPA (baked in at build time)

# --- signaling service ----------------------------------------------------------
# TCP port for HTTP (/health, /turn, /config.json) and WebSocket (/ws). Default 8787.
PORT=8787
# Bind address: 0.0.0.0 inside a container, 127.0.0.1 behind a local TLS proxy.
HOST=0.0.0.0
# Comma-separated exact browser origins allowed to upgrade /ws. Empty = any origin.
# Scheme + host + port, no trailing slash. 403 on mismatch.
ALLOWED_ORIGINS=https://app.example.com,http://localhost:5173
# Concurrent WebSocket client cap; upgrades beyond it return 503.
MAX_CLIENTS=1000
# Largest accepted signaling frame. Protocol ceiling is 32768 bytes (32 KiB).
MAX_SIGNAL_BYTES=32768
# Pairing invitation lifetime in seconds, clamped to 60..900. Default 300.
PAIRING_TTL_SECONDS=300

# --- TURN (coturn static-auth-secret / REST credentials) ------------------------
# Comma-separated coturn URLs advertised to clients. Empty disables TURN and
# clients degrade to STUN-only (the UI says so).
TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp
# Shared secret for short-lived credentials:
#   username   = "<expiry-unix>:<deviceId>"
#   credential = base64(HMAC-SHA1(TURN_SECRET, username))
# Generate with: openssl rand -hex 32
TURN_SECRET=replace-with-openssl-rand-hex-32
# Credential lifetime in seconds, clamped to 60..86400. Default 3600.
TURN_TTL_SECONDS=3600
# Comma-separated STUN URLs. Defaults to the public Google STUN server when empty.
STUN_URLS=stun:stun.l.google.com:19302

# --- coturn container (docker-compose.yml, infra/coturn/entrypoint.sh) ----------
# Public IPv4 of the relay host. Required behind 1:1 NAT / cloud floating IPs.
EXTERNAL_IP=203.0.113.10
# Realm in the 401 challenge. Keep it stable across restarts.
TURNS_REALM=dropzone
# Relay allocation UDP range. Open exactly this range in the firewall.
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200

# --- optional signaling overrides -----------------------------------------------
# Absolute wss:// URL reported by GET /config.json. Unset = derive from
# X-Forwarded-Proto / Host of the incoming request.
#SIGNAL_PUBLIC_URL=wss://signal.example.com/ws
# coturn username prefix used by the Worker variant only (default: none).
#TURN_USERNAME_PREFIX=

# --- static frontend (Vite build-time variable) ----------------------------------
# WebSocket URL the SPA dials. Must be wss:// whenever the page is https://.
# Older builds read VITE_SIGNALING_URL instead; set both while migrating.
VITE_SIGNAL_URL=wss://signal.example.com/ws
#VITE_SIGNALING_URL=wss://signal.example.com/ws
